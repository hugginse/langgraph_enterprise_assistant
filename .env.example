# ---------- 安全与数据库 ----------
SECRET_KEY=dev-secret-key-change-me
JWT_EXPIRE_HOURS=24
DATABASE_URL=postgresql+psycopg2://rag:rag123@localhost:5432/langgraph_enterprise

# ---------- LLM 通道（ollama | openai | anthropic） ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_THINK=true
OLLAMA_NUM_CTX=8192
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_BASE_URL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ---------- Embedding 通道（ollama | openai，无 anthropic） ----------
EMBED_PROVIDER=ollama
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

# ---------- 检索 / 分块 / 存储 / 图 ----------
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHROMA_PERSIST_DIR=chroma_data
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=50
MAX_REWRITE_ATTEMPTS=2
GRADE_WITH_LLM=false
ENABLE_NODE_SSE=true
CHECKPOINT_ENABLED=true
CHECKPOINT_TABLE=langgraph_checkpoints
